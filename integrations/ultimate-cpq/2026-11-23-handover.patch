@@ -0,0 +1,7 @@
+import {requireRole} from '@/server/auth';
+import {handle,json,requireSameOrigin} from '@/server/http';
+import {handoffDetails,testAccept,sendHandoff,syncPandaDocCompletion} from '@/server/workspace-handoff';
+export const dynamic='force-dynamic';
+type Context={params:Promise<{id:string}>};
+export function GET(request:Request,ctx:Context){return handle(async()=>{const who=await requireRole();return json(await handoffDetails((await ctx.params).id,new URL(request.url).origin,who.user.id,who.role==='management'));});}
+export function POST(request:Request,ctx:Context){return handle(async()=>{requireSameOrigin(request);const who=await requireRole('management'),id=(await ctx.params).id;await handoffDetails(id,new URL(request.url).origin,who.user.id,true);const form=await request.formData();if(form.get('action')==='sync-pandadoc')return json(await syncPandaDocCompletion(id,String(form.get('documentId')),new URL(request.url).origin,{id:who.user.id,name:who.user.name||who.user.email},JSON.parse(String(form.get('metadata')))));if(form.get('action')==='retry')return json(await sendHandoff(id));const file=form.get('pdf');if(!(file instanceof File))return json({error:'Choose the test quote PDF.'},422);return json(await testAccept(id,new URL(request.url).origin,{id:who.user.id,name:who.user.name||who.user.email},JSON.parse(String(form.get('metadata'))),new Uint8Array(await file.arrayBuffer())));});}
