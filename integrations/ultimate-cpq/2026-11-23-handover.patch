+const enc=new TextEncoder(),db=()=>env.DB!;
+export const hash=async(v:string|Uint8Array)=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',typeof v==='string'?enc.encode(v):v as any))).map(x=>x.toString(16).padStart(2,'0')).join('');
+const fixtureKey='parramatta-v1';
+export async function setupActor(request:Request){
+ const secret=(env as any).CPQ_REVIEW_SETUP_SECRET;
+ if((env as any).ENABLE_REVIEW_ACCEPTANCE!=='true'||!secret||request.headers.get('Authorization')!=='Bearer '+secret)throw new HttpError(403,'Review setup is unavailable.');
+ const owner:any=await db().prepare("SELECT * FROM cpq_users WHERE lower(email)=lower(?) AND role='management' AND active=1").bind((env as any).CPQ_OWNER_EMAIL||'').first();
+ if(!owner?.identity_id)throw new HttpError(409,'Open the copied CPQ once with the owner account before review setup.');
+ return {id:owner.identity_id,name:owner.name||owner.email};
+}
+export async function createParramatta(actor:string,origin:string){
+ const old:any=await db().prepare('SELECT quote_id FROM cpq_workspace_review WHERE fixture=?').bind(fixtureKey).first();
+ if(old?.quote_id)return {quote:await staffQuote(old.quote_id,origin,actor,true),reused:true};
+ const state=await readState(),kiosk=state.catalogue.records.find(p=>p.id==='KEPO55PMIF'&&p.active);
+ if(!kiosk)throw new HttpError(409,'The review kiosk SKU is not available in this copied catalogue.');
+ const shared={workflowVersion:12,commercial:'purchase',scope:'SIC',channel:'retail',quantity:1,state:'NSW',postcode:'2150',siteName:'Parramatta review site',siteAddress:'Illustrative review site, Parramatta NSW 2150',paymentSchedule:'80/20',paymentScheduleAutomatic:true,care:'none',warrantyYears:3,workingHours:'BH',cmsMode:'none',commissioningDelivery:'onsite'};
+ const led={...shared,kind:'led',family:'micro',pitch:1.25,widthMm:2400,heightMm:1350,controllerSeries:'VX',redundancy:false,label:'Parramatta LED wall'},unit={...shared,kind:'kiosk',productId:kiosk.id,touchFaces:0,label:'Parramatta digital kiosk'};
+ const groups=parseGroups([{id:'parramatta-led-1',label:led.label,input:led},{id:'parramatta-kiosk-1',label:unit.label,input:unit}]);
+ const calc=calculateProject(groups,state,true),pricing:any=calc.pricing;
+ const result=await createQuote({action:'finalise',title:'Parramatta signage project · REVIEW TEST',customerName:'Alex Example',customerEmail:'alex@example.com',customerOrganisation:'Example Retail',siteName:shared.siteName,siteAddress:shared.siteAddress,validDays:90,mode:'fixed',displayMode:'section_totals',allowScopes:false,options:[{label:'Parramatta combined project',input:led,groups,expectedPricebookVersion:pricing?.pricebookVersion,expectedPricingStamp:pricing?.pricingStamp}]},actor,origin,true);
+ await db().prepare('INSERT INTO cpq_workspace_review (fixture,quote_id,created_at) VALUES (?,?,?)').bind(fixtureKey,result.quote.id,new Date().toISOString()).run();
+ return result;
+}
+export async function handoffDetails(quoteId:string,origin:string,actor:string,management:boolean){
+ const quote:any=await staffQuote(quoteId,origin,actor,management),row:any=await db().prepare('SELECT * FROM cpq_workspace_handoffs WHERE quote_id=?').bind(quoteId).first();
+ const fixture=await db().prepare('SELECT fixture FROM cpq_workspace_review WHERE quote_id=?').bind(quoteId).first();
+ return {quote,reviewTest:!!fixture,canTest:management&&!!fixture&&(env as any).ENABLE_REVIEW_ACCEPTANCE==='true',status:row?.status||'Awaiting acceptance',receipt:row?.receipt?JSON.parse(row.receipt):null,error:row?.last_error||'',metadata:row?.packet?JSON.parse(row.packet).project.payload:null,pandadocConfigured:!!(env as any).PANDADOC_API_KEY};
+}
+export function mapQuote(q:any,metadata:any){
+ const option=q.options[0],leaves=option.groups?.length?option.groups:[option];
+ const entries=leaves.map((leaf:any,i:number)=>{
+  const input=leaf.input,g=leaf.geometry,p=leaf.pricing||{},coverage=p.coverage||{};
+  const line=input.kind==='kiosk'?`${g.family||'Digital'} Digital kiosk`:({micro:'PrecisionMicro',pro:'PrecisionPro',luma:'PrecisionLuma',flex:'PrecisionFlex',durablaze:'DuraBlaze',structura:'StructuraSign'} as any)[input.family]||g.family||input.family;
+  const components=(g.components||g.bom||[]).map((c:any)=>({sku:c.productId||c.id,quantity:c.quantity,role:c.role||'component'}));
+  const cabinetSizes=[...new Set((g.layout||[]).map((c:any)=>c.w&&c.h?c.w+' × '+c.h+' mm':'').filter(Boolean))].join(', ');
+  return {id:leaf.id||'screen-'+i,productLine:line,model:g.name||leaf.label||line,category:input.kind==='kiosk'?'Digital kiosk':'LED videowall',configuration:leaf.label+' · '+(input.kind==='kiosk'?`${g.sizeInches}-inch ${g.orientation}, ${g.faces} face(s)`:`${g.widthMm} × ${g.heightMm} mm · P${input.pitch}`),pixelPitch:input.pitch?String(input.pitch):'',dimensions:`${g.widthMm} × ${g.heightMm} mm`,resolution:g.resolutionW&&g.resolutionH?`${g.resolutionW} × ${g.resolutionH}`:'',cabinetSize:cabinetSizes,cabinetQuantity:g.cabinetCount||'',quotedComponents:components,spares:[],input,geometry:g,quotedCoverage:coverage,quotedContract:p.contract||{},installationIncluded:input.scope==='SIC',commissioningIncluded:['SC','SIC'].includes(input.scope),processorIncluded:components.some((c:any)=>c.role==='controller'),mediaPlayerIncluded:(p.lines||[]).some((l:any)=>/media player|android player|windows player/i.test(l.description||l.name||'')),cmsIncluded:input.cmsMode==='tinnox',touchIncluded:Number(input.touchFaces)>0};
+ });
+ const supply=option.input.scope;
+ const stakeholders=Array.isArray(metadata.stakeholders)?metadata.stakeholders:[];
+ if(!stakeholders.some((c:any)=>c.role==='Commercial contact'&&c.name&&c.email))throw new HttpError(422,'Provide the commercial contact name and email.');
+ if(stakeholders.some((c:any)=>!c.role||!c.name||!c.company||!c.email))throw new HttpError(422,'Each stakeholder needs role, company, name and email.');
+ const warranty=entries.map((e:any)=>Number(e.quotedCoverage.warrantyYears||0)*12),care=entries.map((e:any)=>Number(e.quotedCoverage.careTermYears||0)*12);
+ return {number:q.projectNumber,title:q.title,payload:{customer:q.customerOrganisation,site:q.siteAddress,acceptedReference:q.number,commercialContact:`${q.customerName} · ${q.customerEmail}`,salesperson:metadata.salesperson||'CPQ Sales',entries,supplyModel:({SO:'Supply only',SC:'Supply & commissioning',SIC:'Supply, installation & commissioning'} as any)[supply],...Object.fromEntries(['installationIncluded','commissioningIncluded','processorIncluded','mediaPlayerIncluded','cmsIncluded','touchIncluded'].map(k=>[k,entries.some((e:any)=>e[k])])),stakeholders,invoiceEmail:metadata.invoiceEmail||q.customerEmail,scopeNotes:metadata.scopeNotes||'',warrantyMonths:new Set(warranty).size===1?warranty[0]:'',careMonths:new Set(care).size===1?care[0]:'',carePlan:option.input.care||'none',warrantyTerms:entries.map((e:any)=>e.model+': '+(e.quotedCoverage.warrantyLabel||'See accepted quote')+'; '+[e.quotedCoverage.warrantyCommencement?.label,e.quotedCoverage.warrantyCommencement?.delayRule].filter(Boolean).join('. ')).join('\n'),commercial:{totalEx:option.pricing?.subtotalEx,totalGst:option.pricing?.gst,totalInc:option.pricing?.totalInc,paymentSchedule:option.input.paymentSchedule,contract:option.pricing?.contract,eta:option.pricing?.eta},commercialTiming:['Quoted estimate: '+(option.input.leadTime||'See accepted quotation'),...(option.pricing?.eta?.warnings||[]),...(option.pricing?.installation?.notes||[])].join(' '),estimatedDeliveryDate:option.pricing?.eta?.deliveryDate||'',quotedGeneralTerms:q.generalTerms,quotedLegalReferences:q.legalReferences}};
+}
+export async function testAccept(quoteId:string,origin:string,actor:{id:string;name:string},metadata:any,pdf:Uint8Array){
+ const details=await handoffDetails(quoteId,origin,actor.id,true);
+ if(!details.canTest)throw new HttpError(403,'Test acceptance is restricted to the Parramatta review quote.');
+ if(details.receipt||details.status!=='Awaiting acceptance')return sendHandoff(quoteId);
+ if(pdf.length<100||pdf.length>10000000||new TextDecoder().decode(pdf.slice(0,5))!=='%PDF-')throw new HttpError(422,'Attach the test quotation PDF.');
+ if(metadata.testAcknowledged!==true)throw new HttpError(422,'Confirm this is a test acceptance without a customer signature.');
+ return queueAcceptedQuote(details.quote,origin,actor,metadata,pdf,{mode:'test',at:new Date().toISOString(),actor:actor.name,actorId:actor.id,reason:'User-authorised Parramatta end-to-end review. No customer signature or PandaDoc completion.'});
+}
+export async function queueAcceptedQuote(q:any,origin:string,actor:{id:string;name:string},metadata:any,pdf:Uint8Array,acceptance:any){
+ const sha256=await hash(pdf),acceptedAt=acceptance.at,project=mapQuote(q,metadata);
+ const packet={schema:1,source:{system:'ultimate-cpq-copy',quoteId:q.id,rootQuoteId:q.rootQuoteId||q.id,version:q.version,quoteNumber:q.number,quoteUrl:origin+'/quotes/'+q.id,...(acceptance.mode==='test'?{reviewFixture:fixtureKey}:{})},acceptance,project,document:{sha256,name:q.number+(acceptance.mode==='test'?'-TEST-accepted-quote.pdf':'-signed-quote.pdf')}};
+ const objectKey='workspace-handover/'+q.id+'/'+sha256+'.pdf';if(!env.BUCKET)throw new HttpError(503,'Document storage unavailable.');await env.BUCKET.put(objectKey,pdf,{httpMetadata:{contentType:'application/pdf'}});
+ await db().prepare("INSERT OR IGNORE INTO cpq_workspace_handoffs (quote_id,version,status,packet,pdf_key,created_at,updated_at) VALUES (?,?,'Pending',?,?,?,?)").bind(q.id,q.version,JSON.stringify(packet),objectKey,acceptedAt,acceptedAt).run();
+ await db().prepare("UPDATE cpq_quotes SET status=? WHERE id=? AND status='finalised'").bind(acceptance.mode==='test'?'test_accepted':'signed',q.id).run();
+ return sendHandoff(q.id);
+}
+/** Read-only verification against PandaDoc; this never creates or sends a document. */
+export async function syncPandaDocCompletion(quoteId:string,documentId:string,origin:string,actor:{id:string;name:string},metadata:any){
+ const apiKey=(env as any).PANDADOC_API_KEY;if(!apiKey)throw new HttpError(503,'PandaDoc API connection is not configured.');
+ if(!/^[A-Za-z0-9_-]{10,100}$/.test(documentId))throw new HttpError(422,'Enter a valid PandaDoc document ID.');
+ const details=await handoffDetails(quoteId,origin,actor.id,true);if(details.reviewTest)throw new HttpError(409,'The Parramatta review quote must stay a test acceptance.');
+ if(details.status!=='Awaiting acceptance')return sendHandoff(quoteId);
+ const base='https://api.pandadoc.com/public/v1/documents/'+encodeURIComponent(documentId),headers={Authorization:'API-Key '+apiKey};
+ const check=await fetch(base+'/details',{headers,redirect:'manual',signal:AbortSignal.timeout(20000)});if(!check.ok)throw new HttpError(502,'PandaDoc document verification failed.');const doc:any=await check.json();
+ if(doc.id!==documentId||doc.status!=='document.completed')throw new HttpError(409,'PandaDoc has not completed this document.');
+ if(doc.metadata?.tinnox_quote_id!==quoteId||String(doc.metadata?.tinnox_quote_version)!==String(details.quote.version))throw new HttpError(409,'PandaDoc must reference this exact TINNOX quote ID and revision.');
+ const download=await fetch(base+'/download-protected',{headers,redirect:'manual',signal:AbortSignal.timeout(30000)});if(!download.ok)throw new HttpError(502,'The completed PandaDoc PDF is not ready.');const pdf=new Uint8Array(await download.arrayBuffer());
+ if(pdf.length>10000000||new TextDecoder().decode(pdf.slice(0,5))!=='%PDF-')throw new HttpError(422,'PandaDoc did not return a supported completed PDF.');
+ return queueAcceptedQuote(details.quote,origin,actor,metadata,pdf,{mode:'pandadoc',at:doc.date_completed||new Date().toISOString(),documentId,verifiedAt:new Date().toISOString(),actor:actor.name,actorId:actor.id});
+}
+
+export async function sendHandoff(quoteId:string){
+ const row:any=await db().prepare('SELECT * FROM cpq_workspace_handoffs WHERE quote_id=?').bind(quoteId).first();if(!row)throw new HttpError(409,'Accept the quotation before handover.');
+ if(row.status==='Delivered'&&row.receipt)return JSON.parse(row.receipt);
+ const config=env as any,origin=config.TINNOX_WORKSPACE_ORIGIN,secret=config.CPQ_HANDOVER_SECRET;
+ if(origin!=='https://tinnox-workspace-review.tinnox-4852.chatgpt.site'||!secret||!config.TINNOX_WORKSPACE_SERVICE_TOKEN)throw new HttpError(503,'The Workspace connection is not configured.');
+ try{
+  const pdf=await env.BUCKET!.get(row.pdf_key);if(!pdf)throw Error('Accepted PDF missing.');
+  const bytes=new Uint8Array(await pdf.arrayBuffer());let binary='';for(let i=0;i<bytes.length;i+=8192)binary+=String.fromCharCode(...bytes.slice(i,i+8192));
+  const packet=JSON.parse(row.packet),raw=JSON.stringify({...packet,document:{...packet.document,base64:btoa(binary)}}),time=String(Date.now());
+  const key=await crypto.subtle.importKey('raw',enc.encode(secret),{name:'HMAC',hash:'SHA-256'},false,['sign']);
+  const sig=Array.from(new Uint8Array(await crypto.subtle.sign('HMAC',key,enc.encode(time+'.'+raw)))).map(n=>n.toString(16).padStart(2,'0')).join('');
+  const response=await fetch(origin+'/api/integrations/cpq',{method:'POST',redirect:'manual',headers:{'Content-Type':'application/json','OAI-Sites-Authorization':'Bearer '+config.TINNOX_WORKSPACE_SERVICE_TOKEN,'X-Tinnox-Time':time,'X-Tinnox-Signature':sig},body:raw,signal:AbortSignal.timeout(45000)});
+  const result:any=await response.json();if(!response.ok)throw Error(result.error||'Workspace did not accept the handover.');
+  await db().prepare("UPDATE cpq_workspace_handoffs SET status='Delivered',receipt=?,last_error=NULL,updated_at=? WHERE quote_id=?").bind(JSON.stringify(result),new Date().toISOString(),quoteId).run();return result;
+ }catch(e:any){await db().prepare("UPDATE cpq_workspace_handoffs SET status='Retry required',last_error=?,updated_at=? WHERE quote_id=? AND status<>'Delivered'").bind(String(e.message).slice(0,500),new Date().toISOString(),quoteId).run();throw new HttpError(502,'Handover saved. Retry required: '+String(e.message).slice(0,300));}
+}
